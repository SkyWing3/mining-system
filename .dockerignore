# Allow only files needed to build images. Local data and credentials never enter.
**
!backend/**/*.cs
!backend/*.csproj
!backend/appsettings.json
!backend/Dockerfile
!web-app/src/**
!web-app/public/**
!web-app/tests/**/*.ts
!web-app/package.json
!web-app/package-lock.json
!web-app/index.html
!web-app/tsconfig*.json
!web-app/vite.config.ts
!web-app/playwright.config.ts
!web-app/Dockerfile
!device/src/**
!device/requirements.txt
!device/Dockerfile
!infra/docker/nginx.conf

# Also exclude generated/secret files if placed inside an allowed source tree.
**/bin/**
**/obj/**
**/wwwroot/**
**/node_modules/**
**/dist/**
**/build/**
**/.venv/**
**/__pycache__/**
**/*.pyc
**/.env*
**/secrets/**
**/*.credentials.json
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.db*
**/*.sqlite*
**/*.log
**/.DS_Store
