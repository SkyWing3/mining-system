{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "apps/twin-web/public/**",
    "assets/cache/**",
    "test-results/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/immutability": "off",
    "react/purity": "off"
  }
}